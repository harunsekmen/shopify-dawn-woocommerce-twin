{
  "name": "harunsekmen/shopify-dawn-woocommerce-twin",
  "description": "Pixel-perfect reproduction of Shopify's modern Dawn UX on WooCommerce with zero transaction fees.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Harun Sekmen",
      "homepage": "https://github.com/harunsekmen"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "DawnTwin\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}

